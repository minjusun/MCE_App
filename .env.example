# Copy to .env (never commit .env). Values come from the shared dev project's dashboard:
# Project Settings > API Keys / Data API. Only publishable values may use the EXPO_PUBLIC_ prefix,
# because everything with that prefix is bundled into the app.

# App (safe to ship in the client; access is enforced by Row Level Security)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase CLI, for linking and pushing migrations to the shared dev project (developer machines only).
# Use a *scoped* personal access token limited to this project, not the browser-login token.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Never put the secret / service_role key here or anywhere in the app.
