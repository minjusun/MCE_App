#!/bin/sh
# When Claude Code is pushing (CLAUDECODE=1), refuse pushes to main/master,
# branch deletions and non-fast-forward (force) pushes. Your own pushes are not affected.
[ "$CLAUDECODE" = "1" ] || exit 0

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: Claude may not push to ${remote_ref#refs/heads/}. Push a feature branch and open a pull request." >&2
      status=1; continue ;;
  esac
  case "$local_sha" in
    *[!0]*) ;;
    *) echo "pre-push: Claude may not delete remote branch ${remote_ref#refs/heads/}." >&2; status=1; continue ;;
  esac
  case "$remote_sha" in
    *[!0]*)
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: ${remote_ref#refs/heads/} has commits that are not in your branch (or were not fetched). Claude may not force-push." >&2
        status=1
      fi ;;
  esac
done
exit $status
